        <mxCell id="subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=16;fontColor=#5b6b82;" value="Ingesta → &lt;b&gt;Bronze&lt;/b&gt; (crudo) → &lt;b&gt;Silver&lt;/b&gt; (limpio) → &lt;b&gt;Gold&lt;/b&gt; (productos de datos) → Consumo e intercambio" vertex="1">
