        <mxCell id="card0" parent="1" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#4f6fd6;strokeColor=none;fontColor=#ffffff;verticalAlign=top;align=center;spacingTop=16;spacingLeft=14;spacingRight=14;shadow=1;" value="&lt;div style=&quot;text-align:center;font-size:30px&quot;&gt;🏦&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:11px;letter-spacing:1.5px;margin-top:4px&quot;&gt;&lt;b&gt;FUENTES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:18px;margin:6px 0 12px 0&quot;&gt;&lt;b&gt;Origen de datos&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;line-height:1.55&quot;&gt;•&amp;nbsp;Base ficticia (JSON) cargada en Cloud SQL (PostgreSQL)&lt;br&gt;•&amp;nbsp;Simulador Python de adquirentes (con PAN)&lt;br&gt;•&amp;nbsp;Errores y fraude inyectados a propósito&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="270" x="65" y="140" as="geometry" />
        </mxCell>
        <mxCell id="card1" parent="1" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#0f9a8f;strokeColor=none;fontColor=#ffffff;verticalAlign=top;align=center;spacingTop=16;spacingLeft=14;spacingRight=14;shadow=1;" value="&lt;div style=&quot;text-align:center;font-size:30px&quot;&gt;📥&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:11px;letter-spacing:1.5px;margin-top:4px&quot;&gt;&lt;b&gt;INGESTA&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:18px;margin:6px 0 12px 0&quot;&gt;&lt;b&gt;Bronze · Cloud Storage&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;line-height:1.55&quot;&gt;•&amp;nbsp;Cloud Run function de ingesta cada hora&lt;br&gt;•&amp;nbsp;Datastream: backfill + CDC&lt;br&gt;•&amp;nbsp;Dato crudo e inmutable, cifrado con Cloud KMS&lt;/div&gt;" vertex="1">
